# ==========================  ADMIN  ==========================
# ค่าคงที่ทั้งหมดอ่านจากไฟล์ .env ผ่าน {{$dotenv VAR}}
# วิธีใช้: copy .env.simple เป็น .env แล้วกรอกค่าของจริง

### 1.1 LOGIN (เข้าสู่ระบบของแอดมิน)
# @name loginAdmin
POST http://localhost:9091/admin/login
Content-Type: application/json

{
    "email": "",
    "password": "",
    "rememberMe": false
}

###

### 1.2 Register / Signup (สมัครแอดมินใหม่ — ต้องมี registrationToken หรือยังไม่มี admin)
POST http://localhost:9091/admin/register
Content-Type: application/json

{
    "email": "",
    "password": "",
    "firstname": "",
    "lastname": ""
}


###

### 1.3 Forgot (ลืมรหัสผ่านแอดมิน — ส่ง request แล้วได้ code จาก response)
# @name forgotAdmin
POST http://localhost:9091/admin/forgot-password
Content-Type: application/json

{
    "email": ""
}

###

### 1.3.1 Reset (รีเซ็ตรหัสผ่านแอดมิน — ใช้ code จาก forgotAdmin อัตโนมัติ)
###   ⚠ ห้ามใส่ passwordConfirmation เด็ดขาด
###   ⚠ ใส่รหัสใหม่ที่มี [a-z] + [A-Z] + [0-9] อย่างน้อย 8 ตัว
# @name resetAdmin
POST http://localhost:9091/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "",
    "password": ""
}

###

### 1.4 Profile
GET http://localhost:9091/admin/users/me
Authorization: Bearer

###


# ==========================  USER  ==========================

### 2.1 LOGIN (เข้าสู่ระบบ User ทั่วไป)
# @name loginUser
POST http://localhost:9091/api/auth/local
Content-Type: application/json

{
    "identifier": "",
    "password": ""
}

###

### 2.2 Register / Signup (สมัครสมาชิก User ทั่วไป — ใช้เฉพาะตอนยังไม่มี user ในระบบ)
POST http://localhost:9091/api/auth/local/register
Content-Type: application/json

{
    "username": "",
    "email": "",
    "password": ""
}

###


### 2.3 Forgot (ลืมรหัสผ่าน User — ส่ง request แล้วได้ code จาก response)
# @name forgotUser
POST http://localhost:9091/api/auth/forgot-password
Content-Type: application/json
Timeout: 30000

{
    "email": ""
}

###

### 2.3.1 Reset (รีเซ็ตรหัสผ่าน User — ใช้ code จาก forgotUser อัตโนมัติ)
###   ⚠ ต้องมี password + passwordConfirmation ทั้งคู่
# @name resetUser
POST http://localhost:9091/api/auth/reset-password
Content-Type: application/json

{
    "code": "",
    "password": "",
    "passwordConfirmation": ""
}

###

### 2.4 Profile (ดูข้อมูลส่วนตัวของ User)
GET http://localhost:9091/api/users/me
Authorization: Bearer

###